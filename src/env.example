SIGNAL_MIN_RAG_SIMILARITY="0.78"
SIGNAL_MIN_AUTO_SEND_CONFIDENCE="0.82"
SIGNAL_OUTBOUND_COOLDOWN_HOURS="18"

# ----------------------------------------------------------------------------
