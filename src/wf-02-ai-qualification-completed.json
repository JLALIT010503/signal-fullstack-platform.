{
  "name": "SIGNAL WF-02: AI Qualification Completed",
  "nodes": [
    {
      "name": "Webhook Trigger (ai_qualification_completed)",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "ai_qualification_completed",
        "httpMethod": "POST"
      }
